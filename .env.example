# OrbitWatch settings
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in the keys you have:
#     cp .env.example .env
# `.env` is git-ignored, so your keys never reach GitHub.
# Leave a line empty to skip that service. The server reads `.env` when it
# starts; restart it after editing.

# ── News (any one is enough; tried in this order) ─────────────────
# NewsAPI: many outlets, summaries and photos. Free developer key:
#   https://newsapi.org/register
NEWS_API_KEY=

# The Guardian Open Platform: summaries and photos. Free developer key
# (emailed within minutes): https://open-platform.theguardian.com/access
# Without a key the shared public "test" key is used, which is often throttled.
GUARDIAN_API_KEY=

# Force a single provider instead of the fallback chain: newsapi, gdelt or guardian
NEWS_PROVIDER=

# ── Kaggle (to download the training dataset) ─────────────────────
# Kaggle → your avatar → Settings → API → "Create New Token". It downloads
# kaggle.json; copy "username" and "key" from it here.
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Model ─────────────────────────────────────────────────────────
# Path to trained weights (created by `python train.py`)
MODEL_CHECKPOINT=best_model.pth
